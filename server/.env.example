# ---------------------------------------------------------------------------
# Copy this file to  server/.env  and edit.
# ---------------------------------------------------------------------------

# How often the poller reads the machine DB and refreshes the snapshot.
POLL_INTERVAL_SECONDS=5

# Where the dashboard's own SQLite file lives (created automatically).
DASHBOARD_DB_PATH=./data/dashboard.db

# API server bind.
API_HOST=127.0.0.1
API_PORT=8000

# ---------------------------------------------------------------------------
# MACHINE DATABASE  (the machine's real DB you write SELECT queries against)
#
#   mock      -> no external DB, generates realistic fake readings.
#                Use this to run everything end-to-end with zero setup.
#   sqlserver -> connect to a real Microsoft SQL Server using the settings below.
# ---------------------------------------------------------------------------
MACHINE_DB_MODE=mock

# Only used when MACHINE_DB_MODE=sqlserver
MACHINE_DB_DRIVER=ODBC Driver 18 for SQL Server
MACHINE_DB_SERVER=localhost,1433
MACHINE_DB_DATABASE=MachineDB
MACHINE_DB_USER=sa
MACHINE_DB_PASSWORD=changeme
# TrustServerCertificate=yes is convenient for local/dev; review for production.
MACHINE_DB_EXTRA=TrustServerCertificate=yes;Encrypt=yes
